{
  "manifest_version": 3,
  "name": "OneDrive Revision Shortcuts",
  "version": "1.0.0",
  "description": "Adds keyboard shortcuts for OneDrive revision controls (Ctrl+[, Ctrl+], Ctrl+', Ctrl+\\)",
  "permissions": [],
  "host_permissions": [
    "https://onedrive.live.com/*",
    "https://*.officeapps.live.com/*",
    "https://my.microsoftpersonalcontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://onedrive.live.com/personal/*",
        "https://*.officeapps.live.com/*",
        "https://my.microsoftpersonalcontent.com/personal/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "icons": {
  }
}
